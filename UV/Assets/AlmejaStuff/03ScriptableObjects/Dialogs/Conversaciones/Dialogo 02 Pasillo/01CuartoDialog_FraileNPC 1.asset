  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e13e01f58019a4b14b8aab03af3f6763, type: 3}
  m_Name: 01CuartoDialog_FraileNPC 1
  m_EditorClassIdentifier: 
  leftCharacter: {fileID: 11400000, guid: cc5b5a8b9ee32954593050065091b92e, type: 2}
  rightCharacter: {fileID: 11400000, guid: 5e16f97705d43c047a3bfa0e6add9f1e, type: 2}
  sentences:
  - character: {fileID: 11400000, guid: 5e16f97705d43c047a3bfa0e6add9f1e, type: 2}
    text: "\xA1Buenos d\xEDas Fray.! espero que haya descansado bien\u2026 S\xE9
      que ya est\xE1 a nada de terminar el c\xF3dice que est\xE1 transcribiendo.\r"
  - character: {fileID: 11400000, guid: cc5b5a8b9ee32954593050065091b92e, type: 2}
    text: "Buenos d\xEDas, hijo. El descanso es breve cuando la memoria de un pueblo
      llama. S\xED, estamos cerca\u2026 pero en estas \xFAltimas p\xE1ginas la tinta
      pesa el doble."
  - character: {fileID: 11400000, guid: 5e16f97705d43c047a3bfa0e6add9f1e, type: 2}
    text: "\xBFEn qu\xE9 parte va ahora?"
  - character: {fileID: 11400000, guid: cc5b5a8b9ee32954593050065091b92e, type: 2}
    text: "En el pasaje donde los Gemelos descienden a Xibalb\xE1. No es solo aventura:
      es ense\xF1anza. Hablan de ingenio frente al poder injusto, y de c\xF3mo la
      vida sabe re\xEDrse de la muerte. Si traduzco mal, se tuerce el sentido; si
      resumo de m\xE1s, se pierde la m\xFAsica."
