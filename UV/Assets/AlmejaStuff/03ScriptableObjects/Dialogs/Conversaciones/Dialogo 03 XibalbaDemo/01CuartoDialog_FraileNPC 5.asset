  m_Script: {fileID: 11500000, guid: e13e01f58019a4b14b8aab03af3f6763, type: 3}
  m_Name: 01CuartoDialog_FraileNPC 5
  m_EditorClassIdentifier: 
  leftCharacter: {fileID: 11400000, guid: 1e305b41ed9f8be46bcc52ac110ba113, type: 2}
  rightCharacter: {fileID: 11400000, guid: f89765118788716429593870b25a3bd9, type: 2}
  sentences:
  - character: {fileID: 11400000, guid: f89765118788716429593870b25a3bd9, type: 2}
    text: "Su corteza parece enrojecida, \xBFser\xE1 este?"
  - character: {fileID: 11400000, guid: c0dfe9314a37d60419b2f2461bf33ec3, type: 2}
    text: "Enga\xF1a la vista: la piel es roja, pero la goma se vuelve p\xE1lida
      en el humo y se deshace pronto."
  - character: {fileID: 11400000, guid: f89765118788716429593870b25a3bd9, type: 2}
    text: "No mantendr\xEDa el latido en el brasero."
  - character: {fileID: 11400000, guid: 6ade437b8d66a5e4c874c1bac2d863de, type: 2}
    text: "Seguimos: buscamos resina que pese, ti\xF1a y crepite como si respirara."
