  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e13e01f58019a4b14b8aab03af3f6763, type: 3}
  m_Name: 01CuartoDialog_FraileNPC 3
  m_EditorClassIdentifier: 
  leftCharacter: {fileID: 11400000, guid: 1e305b41ed9f8be46bcc52ac110ba113, type: 2}
  rightCharacter: {fileID: 11400000, guid: f89765118788716429593870b25a3bd9, type: 2}
  sentences:
  - character: {fileID: 11400000, guid: 1e305b41ed9f8be46bcc52ac110ba113, type: 2}
    text: "Ixquic, lo vi con estos ojos chicos: las pulgas se llevaban el \xE1rbol"
  - character: {fileID: 11400000, guid: f89765118788716429593870b25a3bd9, type: 2}
    text: "\xBF\xA1El \xE1rbol entero!?"
  - character: {fileID: 11400000, guid: 1e305b41ed9f8be46bcc52ac110ba113, type: 2}
    text: "No el tronco grande; el hijuelo de la grana, el reto\xF1o. Lo arrancaron
      en coro, amarrado con fibra de maguey y telara\xF1a, y lo rodaban como tambor.
      Sus huellas: tres puntitos y un vac\xEDo, repetidos"
  - character: {fileID: 11400000, guid: f89765118788716429593870b25a3bd9, type: 2}
    text: "\xBFHacia d\xF3nde fueron?"
  - character: {fileID: 11400000, guid: 1e305b41ed9f8be46bcc52ac110ba113, type: 2}
    text: "Por este sendero, o\xED sus risitas: \u201C\xA1arriba el bot\xEDn!\u201D
      Y ol\xEDa a tierra h\xFAmeda y resina."
