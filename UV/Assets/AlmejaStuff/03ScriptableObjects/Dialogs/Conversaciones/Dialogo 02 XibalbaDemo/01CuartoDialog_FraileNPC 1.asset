MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e13e01f58019a4b14b8aab03af3f6763, type: 3}
  m_Name: 01CuartoDialog_FraileNPC 1
  m_EditorClassIdentifier: 
  leftCharacter: {fileID: 11400000, guid: 1e305b41ed9f8be46bcc52ac110ba113, type: 2}
  rightCharacter: {fileID: 11400000, guid: f89765118788716429593870b25a3bd9, type: 2}
  sentences:
  - character: {fileID: 11400000, guid: 1e305b41ed9f8be46bcc52ac110ba113, type: 2}
    text: "No puedes irte as\xED, Ixquic. Si te presentas sin ofrenda, los Se\xF1ores
      de Xibalb\xE1 pedir\xE1n tu coraz\xF3n.\r\r"
  - character: {fileID: 11400000, guid: f89765118788716429593870b25a3bd9, type: 2}
    text: "\xBFEntonces\u2026 qu\xE9 hago?"
  - character: {fileID: 11400000, guid: c0dfe9314a37d60419b2f2461bf33ec3, type: 2}
    text: "Cambia el destino por astucia: toma resina del \xE1rbol de la grana. La
      resina es roja, pesa y huele; en el brasero har\xE1 el papel de tu coraz\xF3n."
  - character: {fileID: 11400000, guid: f89765118788716429593870b25a3bd9, type: 2}
    text: "\xBFY si notan que no late?"
  - character: {fileID: 11400000, guid: 6ade437b8d66a5e4c874c1bac2d863de, type: 2}
    text: "El fuego latir\xE1 por ti. La resina estalla y oscurece como sangre; eso
      los enga\xF1ar\xE1."
